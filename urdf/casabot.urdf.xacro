<?xml version="1.0"?>
<robot name="casabot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Set these to match the chassis you actually build. -->
  <xacro:arg name="use_sim" default="false"/>
  <xacro:property name="wheel_radius"     value="0.0325"/>
  <xacro:property name="wheel_width"      value="0.026"/>
  <xacro:property name="wheel_separation" value="0.20"/>
  <xacro:property name="base_length"      value="0.22"/>
  <xacro:property name="base_width"       value="0.17"/>
  <xacro:property name="base_height"      value="0.07"/>
  <xacro:property name="base_clearance"   value="0.02"/>
  <xacro:property name="base_mass"        value="1.6"/>
  <xacro:property name="wheel_mass"       value="0.05"/>

  <material name="grey"><color rgba="0.3 0.3 0.32 1"/></material>
  <material name="dark"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="red"><color rgba="0.7 0.1 0.1 1"/></material>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" iyy="${m*(x*x+z*z)/12}" izz="${m*(x*x+y*y)/12}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- base_footprint sits on the floor; everything Nav2 reasons about hangs off it. -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + base_clearance}"/>
  </joint>

  <xacro:macro name="wheel" params="side reflect">
    <link name="${side}_wheel_link">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12}"
                 iyy="${wheel_mass*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12}"
                 izz="${wheel_mass*wheel_radius*wheel_radius/2}"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${reflect * wheel_separation/2} ${-base_clearance}"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel side="left"  reflect="1"/>
  <xacro:wheel side="right" reflect="-1"/>

  <!-- Single rear ball caster. Modelled as a sphere so it slides in sim. -->
  <link name="caster_link">
    <visual><geometry><sphere radius="${base_clearance/2 + 0.005}"/></geometry><material name="dark"/></visual>
    <collision><geometry><sphere radius="${base_clearance/2 + 0.005}"/></geometry></collision>
    <inertial><mass value="0.02"/><inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${-base_length/2 + 0.03} 0 ${-base_height/2 - base_clearance/2 + 0.005}"/>
  </joint>

  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.038" length="0.04"/></geometry><material name="red"/></visual>
    <collision><geometry><cylinder radius="0.038" length="0.04"/></geometry></collision>
    <inertial><mass value="0.19"/><inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${base_height/2 + 0.02}"/>
  </joint>

  <link name="imu_link">
    <inertial><mass value="0.005"/><inertia ixx="1e-7" iyy="1e-7" izz="1e-7" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.04 0 ${base_height/2}"/>
  </joint>

  <xacro:if value="$(arg use_sim)">
    <xacro:include filename="$(find casabot)/urdf/gazebo.xacro"/>
  </xacro:if>

</robot>
