<?xml version="1.0"?>
<!-- A small two-room apartment, big enough that SLAM has to close a loop.
     Robot spawns in the lower-left room; the doorway is at about (-1, -0.3). -->
<sdf version="1.9">
  <world name="house">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.3 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="house">
      <static>true</static>
      <link name="wall_s">
        <pose>0.0 -3.0 0.500 0 0 0</pose>
        <collision name="c"><geometry><box><size>8.1 0.1 1.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>8.1 0.1 1.0</size></box></geometry>
          <material><ambient>0.8 0.78 0.74 1</ambient><diffuse>0.8 0.78 0.74 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_n">
        <pose>0.0 3.0 0.500 0 0 0</pose>
        <collision name="c"><geometry><box><size>8.1 0.1 1.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>8.1 0.1 1.0</size></box></geometry>
          <material><ambient>0.8 0.78 0.74 1</ambient><diffuse>0.8 0.78 0.74 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_w">
        <pose>-4.0 0.0 0.500 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 6.1 1.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.1 6.1 1.0</size></box></geometry>
          <material><ambient>0.8 0.78 0.74 1</ambient><diffuse>0.8 0.78 0.74 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_e">
        <pose>4.0 0.0 0.500 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 6.1 1.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.1 6.1 1.0</size></box></geometry>
          <material><ambient>0.8 0.78 0.74 1</ambient><diffuse>0.8 0.78 0.74 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_hall_lower">
        <pose>-1.0 -1.9 0.500 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 2.2 1.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.1 2.2 1.0</size></box></geometry>
          <material><ambient>0.8 0.78 0.74 1</ambient><diffuse>0.8 0.78 0.74 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_hall_upper">
        <pose>-1.0 1.6 0.500 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 2.8 1.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.1 2.8 1.0</size></box></geometry>
          <material><ambient>0.8 0.78 0.74 1</ambient><diffuse>0.8 0.78 0.74 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_divider">
        <pose>0.45 0.0 0.500 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.9 0.1 1.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>2.9 0.1 1.0</size></box></geometry>
          <material><ambient>0.8 0.78 0.74 1</ambient><diffuse>0.8 0.78 0.74 1</diffuse></material>
        </visual>
      </link>
      <link name="table">
        <pose>2.3 -2.0 0.375 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.2 0.7 0.75</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.2 0.7 0.75</size></box></geometry>
          <material><ambient>0.45 0.32 0.25 1</ambient><diffuse>0.45 0.32 0.25 1</diffuse></material>
        </visual>
      </link>
      <link name="sofa">
        <pose>-3.0 1.6 0.225 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.8 1.6 0.45</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.8 1.6 0.45</size></box></geometry>
          <material><ambient>0.45 0.32 0.25 1</ambient><diffuse>0.45 0.32 0.25 1</diffuse></material>
        </visual>
      </link>
      <link name="box">
        <pose>1.2 2.2 0.250 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.45 0.32 0.25 1</ambient><diffuse>0.45 0.32 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
